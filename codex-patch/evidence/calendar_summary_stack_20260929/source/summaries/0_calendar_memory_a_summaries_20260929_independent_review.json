 "author_unresolved_judgments": [
  {
   "item": "E50506 의성어 해석",
   "judgment": "수정함(걷어찬→때린). 근거는 findings 참조."
  },
  {
   "item": "11/1 밤 계열 4장면(50505·50507·50510·50512)",
   "judgment": "현 서술 유지가 옳다. 네 장면 모두 장면 안에서 꿈·환각이라고 밝히지 않으므로 꿈이라고 쓰면 (a) 원문 밖 추정이 된다. 원본 표기(11/1 밤)와 장면 속 시각(아침·오후·방과 후)이 어긋나는 것은 요약이 장면 내용을 따른 결과이며 결함 아님. 남는 것은 사용자 스포일러 노출 판단뿐(미열람 가림은 빌드 쪽 확인 사항)."
  },
  {
   "item": "시간 경과 4장면(50112·50212·50310·50410)",
   "judgment": "현 서술 유지. 50112·50212(반년 뒤)·50410(몇 달 뒤)은 각 장면 첫 줄 서술을 그대로 옮겼고, 50310은 장면 안에 「수개월」과 「반년」이 함께 나와 기간을 적지 않은 것이 맞다. 나중 사건 암시가 아니라 장면 안 사실."
  }
 ],
 "unresolved": [
